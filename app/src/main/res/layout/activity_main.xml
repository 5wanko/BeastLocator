<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:clipChildren="false"
		android:clipToPadding="false"
		android:fitsSystemWindows="true">

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/settings"
        android:padding="10dp"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/expressive_on_surface" />

    <ImageButton
        android:id="@+id/distanceMaskToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/distance_mask_button_content_description_off"
        android:padding="10dp"
        android:src="@drawable/ic_visibility_off"
        app:layout_constraintBottom_toBottomOf="@id/settingsButton"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        app:layout_constraintTop_toTopOf="@id/settingsButton"
        app:tint="@color/expressive_on_surface" />

    <LinearLayout
        android:id="@+id/centerContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/arrowView"
            android:layout_width="208dp"
            android:layout_height="208dp"
            android:contentDescription="@string/arrow"
            android:padding="16dp"
            android:scaleType="centerInside"
            android:src="@drawable/yjsnpi" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/noto_sans_jp"
            android:text="@string/waiting_location"
            android:textColor="@color/expressive_on_surface"
            android:textLocale="ja-JP"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/directionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/noto_sans_jp"
            android:text="@string/direction_placeholder"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="30sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/arrivalContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/arrivalTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/noto_sans_jp"
            android:gravity="center_horizontal"
            android:text="@string/arrival_title"
            android:textAlignment="center"
            android:textColor="@color/expressive_on_surface"
            android:textLocale="ja-JP"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrivalNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/noto_sans_jp"
            android:gravity="start"
            android:text="@string/arrival_name_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/arrivalCoordsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/noto_sans_mono"
            android:gravity="start"
            android:text="@string/arrival_coords_placeholder"
            android:textAlignment="viewStart"
            android:textColor="@color/expressive_on_surface_variant"
            android:textLocale="ja-JP"
            android:textSize="14sp" />

        <Button
            android:id="@+id/createNextDestinationButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="@string/create_next_destination" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

